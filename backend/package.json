{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "description": "TaskFlow REST API built with Express, TypeScript, Prisma and PostgreSQL",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
